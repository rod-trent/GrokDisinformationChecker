{
  "manifest_version": 3,
  "name": "Grok Disinformation Checker",
  "version": "1.1.0",
  "description": "Instantly analyze any web page or selected text for disinformation and misinformation using Grok AI with real-time live search.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": ["https://api.x.ai/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Grok Disinformation Checker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "check-page": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Check current page for disinformation"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "privacy.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
